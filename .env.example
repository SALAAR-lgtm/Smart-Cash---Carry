# PostgreSQL settings
POSTGRES_DB=smart_cash_carry
POSTGRES_USER=smartcash
POSTGRES_PASSWORD=replace_with_a_strong_password
POSTGRES_PORT=5432

# Internal Docker networking settings
DB_HOST=db
DB_PORT=5432
BACKEND_HOST=backend

# Application ports
BACKEND_PORT=4000
FRONTEND_PORT=5173

# Initial administrator seed and JWT signing settings
ADMIN_USERNAME=replace_with_admin_username
ADMIN_PASSWORD=replace_with_a_strong_admin_password
JWT_SECRET=replace_with_a_long_random_jwt_secret
